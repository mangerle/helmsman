#!/bin/sh
set -e

case "$1" in
  configure)
    mkdir -p /etc/helmsman /var/backups/grub-manager
    chmod 0755 /etc/helmsman
    chmod 0700 /var/backups/grub-manager

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
      systemctl reload dbus.service >/dev/null 2>&1 || true
      systemctl try-restart helmsman.service >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
