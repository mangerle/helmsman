[Unit]
Description=Helmsman Privileged Helper Service
Documentation=https://github.com/mangerle/helmsman

[Service]
Type=dbus
BusName=org.freedesktop.Helmsman
ExecStart=/usr/libexec/helmsman-daemon
User=root
StandardOutput=journal
StandardError=journal

# 最小权限安全沙箱加固 (Security Hardening)
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_ADMIN
# 必须覆盖代码实际写入路径：默认配置、受管自定义脚本、别名注册表、引导分区、快照备份
ReadWritePaths=/etc/default/grub /etc/grub.d /etc/helmsman /boot /var/backups/grub-manager /run /tmp

